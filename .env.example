VITE_API_BASE_URL=https://api.example.com
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
VITE_SHIPPING_PROVIDER_KEY=replace_me
VITE_AUTH_PROVIDER_URL=https://auth.example.com
PORT=4000
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_ORIGIN=http://127.0.0.1:5173
DEMO_ADMIN_EMAIL=admin@lumiere.test
DEMO_ADMIN_PASSWORD=ChangeMe123!
FIREBASE_PROJECT_ID=your-firebase-project-id
# Use one of the following secure Firebase Admin credential options in production.
# Preferred for Render: paste the complete service-account JSON as a secret value.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-firebase-project-id"}
# Or provide the individual service-account fields below.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nreplace_me\\n-----END PRIVATE KEY-----\\n"
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com
# For local ADC, set the project ID above and run: gcloud auth application-default login
# For a deployed Google Cloud service, attach the lumiere-backend service account.
